# 线上部署的环境变量（复制成 .env 放在仓库根目录，docker compose 会自动读取）
#
#   cp deploy/env.production.example .env
#
# 说明：docker-compose.yml 里对 JWT_SECRET 用的是 `${JWT_SECRET:-占位值}`，
# 所以 .env 里这一项必须换成随机串，否则线上会用默认占位密钥。

# 【必填】JWT 签名密钥：上线必须换成一串随机值（deploy/up.sh 会自动生成）
#   生成：openssl rand -hex 32     或     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_32_BYTES

# 对外访问端口（默认 8080，被占用时改成别的，例如 80）
WEB_PORT=8080

# 数据库口令（首次启动时由 postgres 容器初始化；改这里要同时改 DATABASE_URL）
POSTGRES_PASSWORD=cs_training_pwd

# 商品分享链接无头浏览器抓取服务（deploy/scraper，compose 内网地址，一般不配改）
# 一键添加商品时优先调用它抓取抖音/淘宝/京东商品页的价格与图片；
# 服务不可用会自动回退到纯 HTTP 解析 + 分享文案标题兜底。
SCRAPER_URL=http://scraper:9090
