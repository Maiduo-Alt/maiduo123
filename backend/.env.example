# 服务端口
PORT=3000

# PostgreSQL（本地开发可用 tools/dev-postgres.mjs 启动嵌入式实例）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/cs_training
# 无 PostgreSQL 时可选：使用内存数据库（pg-mem），进程重启数据清空
USE_PG_MEM=false
# 连接池
PG_POOL_MAX=10

# Redis：留空则定时调度走进程内实现（单机开发/测试，零外部依赖）；
# 填写后买家消息推送/超时扫描改用 Redis 延迟队列，多实例部署时周期任务只会由一个实例执行（方案 5.5）
REDIS_URL=

# JWT
JWT_SECRET=cs-training-dev-secret-change-me
JWT_EXPIRES_IN=8h

# 初始化管理员
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
